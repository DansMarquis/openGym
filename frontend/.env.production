# Production build config for the Vercel deployment.
#
# openGym's exercise animations (stills + clips, ~215 MB) are NOT shipped in the Vercel
# deployment. Instead they're served by jsDelivr's CDN straight from this public fork's
# catalogue/media directory. exercises.js reads these at build time (IMG_BASE/GIF_BASE); see its
# note about not "shipping ~140 MB of images into the deployment".
#
# Pinned to the `main` branch — the media is immutable, so jsDelivr's branch caching is harmless.
VITE_IMG_BASE=https://cdn.jsdelivr.net/gh/DansMarquis/openGym@main/catalogue/media/still/
VITE_GIF_BASE=https://cdn.jsdelivr.net/gh/DansMarquis/openGym@main/catalogue/media/clip/
